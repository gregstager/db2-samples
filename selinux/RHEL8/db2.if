
## <summary>policy for db2</summary>


########################################
## <summary>
##    Role access for db2 admins
## </summary>
## <param name="role">
##    <summary>
##       Role allowed to access Db2 administrative functions.
##    </summary>
## </param>
## <param name="domain">
##    <summary>
##       User domain for the role.
##    </summary>
## </param>
#
interface(`db2_adminusers_role',`
    require {
        attribute_role db2_adminusers_roles;
        attribute db2_adminusers_types;
    }

   roleattribute $1 db2_adminusers_roles;
   typeattribute $2 db2_adminusers_types;
   role $1 types db2d_t;
')

